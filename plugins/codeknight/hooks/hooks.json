{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/codeknight-mcp.js", "--pre-commit-hook"],
            "onFailure": "block",
            "statusMessage": "CodeKnight pre-commit check"
          },
          {
            "type": "command",
            "if": "Bash(git commit)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/codeknight-mcp.js", "--pre-commit-hook"],
            "onFailure": "block",
            "statusMessage": "CodeKnight pre-commit check"
          },
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/codeknight-mcp.js", "--pre-commit-hook"],
            "onFailure": "block",
            "statusMessage": "CodeKnight pre-commit check"
          },
          {
            "type": "command",
            "if": "PowerShell(git commit)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/codeknight-mcp.js", "--pre-commit-hook"],
            "onFailure": "block",
            "statusMessage": "CodeKnight pre-commit check"
          }
        ]
      }
    ]
  }
}
